# --- MedNet Tracker: настройки сервера ---------------------------------
# Скопируйте этот файл в .env и поправьте значения.

# Адрес и порт. HOST=0.0.0.0 делает приложение видимым в локальной сети.
HOST=0.0.0.0
PORT=3000

# Учётная запись администратора. Используется ОДИН РАЗ - при первом
# запуске, когда база ещё пуста. Дальше пароль меняется в интерфейсе,
# а в базе хранится только его bcrypt-хеш.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ключ подписи сессионной куки. Замените на любую длинную случайную
# строку: сгенерировать можно командой
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Сколько часов держится вход без активности
SESSION_HOURS=12

# Ставьте 1, только если приложение работает по https
COOKIE_SECURE=0

# Ставьте 1, если перед приложением стоит nginx или другой обратный прокси
TRUST_PROXY=0
