# --- Зависимости ------------------------------------------------------
node_modules/

# --- Настройки с секретами --------------------------------------------
# Пароль администратора и ключ подписи сессий. Образцы .env.example и
# .env.docker.example в репозитории есть, сам .env быть не должен.
.env
.env.local
.env.*.local

# --- Данные -----------------------------------------------------------
# База, её журналы WAL и резервные копии: в них учётные сведения,
# MAC-адреса и пароли сетевого оборудования.
data/database.sqlite
data/database.sqlite-wal
data/database.sqlite-shm
data/backups/

# Загруженные и сгенерированные планы этажей. Файл-образец
# _TEMPLATE_floor.svg под правило не подпадает и остаётся в репозитории.
data/svg/floor-*.svg

# --- Прочее -----------------------------------------------------------
*.log
npm-debug.log*
*.tar.gz
coverage/
.nyc_output/

# Служебные файлы операционных систем
.DS_Store
Thumbs.db
desktop.ini
