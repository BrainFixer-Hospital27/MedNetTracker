# Окончания строк.
#
# Проект правится и на Windows, и на Linux, поэтому в репозитории всё
# хранится с переводом строки LF, а в рабочем каталоге Git подставляет
# привычные системе. Без этого правила первый же коммит с Windows
# показал бы «изменения» во всех файлах разом.
* text=auto eol=lf

# Двоичные файлы Git трогать не должен
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.xlsx   binary
*.sqlite binary
*.woff   binary
*.woff2  binary

# Библиотеки во vendor не наши: пусть Git не показывает их в различиях
# и не считает при подсчёте языков репозитория
public/vendor/*.js linguist-vendored

# Планы этажей — текст, но различия по ним нечитаемы
*.svg text eol=lf diff=false
