# --- Настройки развёртывания в Docker -------------------------------
# Скопируйте в .env рядом с docker-compose.yml

# Адрес, на котором слушает приложение.
#   10.13.13.1  — адрес сервера внутри WireGuard: доступ только по VPN
#   127.0.0.1   — только локально, для доступа через nginx на том же хосте
#   0.0.0.0     — на всех интерфейсах, включая публичный (осознанно!)
BIND_ADDRESS=10.13.13.1
PUBLIC_PORT=3000

TZ=Europe/Kyiv

# Учётная запись администратора. Используется один раз, при создании базы.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Ключ подписи сессионной куки:
#   openssl rand -hex 32
SESSION_SECRET=

SESSION_HOURS=12

# Ставьте 1, только если доступ идёт по https
COOKIE_SECURE=0

# Сколько обратных прокси перед приложением:
#   0 — прямое подключение или доступ по VPN
#   1 — nginx или Caddy на том же сервере
#   2 — Cloudflare плюс nginx
TRUST_PROXY=0

# За Cloudflare раскомментируйте — иначе блокировка при переборе
# пароля сработает сразу для всех посетителей
# REAL_IP_HEADER=cf-connecting-ip
